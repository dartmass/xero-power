{
  "manifest_version": 3,
  "name": "Xero Power — Shortcuts & Command Palette",
  "version": "0.8.0",
  "description": "Keyboard-first power tools for Xero. Ctrl+K command palette, bank rec shortcuts, default-to-Approve for invoices, and more.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Xero Power",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.polar.sh/*"],
  "content_scripts": [
    {
      "matches": ["https://*.xero.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
